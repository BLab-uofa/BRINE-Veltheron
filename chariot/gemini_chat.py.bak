from __future__ import annotations

import argparse
from pathlib import Path

from agent.gemini_observer import GeminiObserver
from config import load_config
from observer.loader import load_brine_csv
from observer.plots import create_plot
from shadow.decision_log import load_decision_log
from shadow.view import build_shadow_view


def choose_default_decision_log(cfg: dict) -> Path:
    live = Path(cfg["shadow"]["decision_log_csv"])
    replay = Path(cfg["shadow"]["replay_output_csv"])
    if live.exists():
        return live
    if replay.exists():
        return replay
    return live


def main():
    p = argparse.ArgumentParser(description="Read-only Gemini scientific observer for continuously updating BRINE + causal CHARIOT shadow")
    p.add_argument("--file", default="data/demo_candidates.csv", help="BRINE CSV to observe")
    p.add_argument("--decision-log", "--shadow", dest="decision_log", default=None, help="Frozen CHARIOT decision log or causal replay CSV")
    p.add_argument("--bond", action="store_true", help="Allow Valency Bond literature lookup when requested")
    p.add_argument("--config", default=None)
    args = p.parse_args()

    cfg = load_config(args.config)
    campaign = Path(args.file)
    decision_log = Path(args.decision_log) if args.decision_log else choose_default_decision_log(cfg)
    obs = GeminiObserver(config_path=args.config)

    print("\nBRINE Scientific Observer is running.")
    print("Gemini is READ-ONLY: it cannot modify BRINE, BO, the twin, or CHARIOT.")
    print("The twin predicts conductivity only; CHARIOT never predicts LSV outcome.")
    print("Campaign and CHARIOT state are reloaded before EVERY answer.")
    print(f"Campaign file: {campaign.resolve()}")
    print(f"Decision log:  {decision_log.resolve()}")
    if not decision_log.exists():
        print("Decision log does not exist yet. Campaign questions will still work, but CHARIOT questions will have no frozen decisions until the monitor/replay creates them.")
    print("Type 'quit' to exit.\n")

    while True:
        q = input("You > ").strip()
        if q.lower() in {"quit", "exit", "q"}:
            break
        try:
            response = obs.analyze(q, campaign, decision_log, use_bond=args.bond)
            print("\nGemini > " + response.answer + "\n")
            if response.plot_request:
                # Fresh reload on every explicit plot request.
                df = load_brine_csv(campaign, cfg)
                decisions = load_decision_log(decision_log)
                shadow_view = build_shadow_view(df, decisions)
                safe_name = response.plot_request.plot_type
                if response.plot_request.input_name:
                    safe_name += "_" + response.plot_request.input_name
                out = Path("outputs/plots") / f"{safe_name}.png"
                create_plot(
                    df,
                    shadow_view,
                    response.plot_request.plot_type,
                    out,
                    cfg,
                    input_name=response.plot_request.input_name,
                )
                print(f"Plot saved to: {out.resolve()}\n")
        except Exception as exc:
            print(f"\nObserver error: {exc}\n")


if __name__ == "__main__":
    main()
